---
import { getIconData, iconToSVG } from "@iconify/utils";
import mdi from "@iconify-json/mdi/icons.json";
import { profileGithubUrl } from "@/config";
import { url } from "@/utils/url-utils";

interface MenuItem {
	icon?: string;
	label: string;
	action: string;
}

interface CharBox {
	x0: number;
	x1: number;
	y0: number;
	y1: number;
}

interface ModelItem {
	path: string;
	volume?: number;
	scale?: number;
	x?: number;
	y?: number;
	charBox?: CharBox;
}

interface Props {
	config: {
		enable: boolean;
		model: ModelItem | ModelItem[];
		position?: "bottom-left" | "bottom-right";
		size?: number | { width: number; height: number };
		primaryColor?: string;
		transitionDuration?: number;
		transitionType?: "slide" | "fade";
		menus?: {
			items?: MenuItem[];
			extraItems?: MenuItem[];
			align?: "left" | "right";
		};
		tips?: {
			enable?: boolean;
			welcomeMessage?: string[];
			messages?: string[];
			duration?: number;
			interval?: number;
			offset?: { x?: number; y?: number };
			typing?: {
				param?: string;
				speed?: number;
				minValue?: number;
				maxValue?: number;
			};
		};
		responsive?: {
			hideOnMobile?: boolean;
			mobileBreakpoint?: number;
		};
		draggable?: {
			enable?: boolean;
			longPressMs?: number;
			savePosition?: boolean;
		};
		sleep?: {
			autoSleepMinutes?: number;
		};
	};
}

const { config } = Astro.props;

// 构建模型配置
const models = Array.isArray(config.model) ? config.model : [config.model];
const resolvePath = (p: string) => (/^https?:\/\//.test(p) ? p : url(p));

const modelConfigs = models.map((m) => ({
	path: resolvePath(m.path),
	...(m.volume !== undefined && { volume: m.volume }),
	...(m.scale !== undefined && { scale: m.scale }),
	...((m.x !== undefined || m.y !== undefined) && {
		offset: [m.x ?? 0, m.y ?? 0],
	}),
	...(m.charBox && { charBox: m.charBox }),
}));

// 序列化菜单配置（icon 在构建期解析成内联 SVG data URI，运行时不再请求
// api.iconify.design——离线/被墙时图标不会退化成文字，也省去首次闪烁）
function serializeMenus(menus: Props["config"]["menus"]) {
	if (!menus) return {};
	const serialize = (items: MenuItem[]) =>
		items.map(({ icon, label, action }) => ({
			icon: icon && inlineIcon(icon),
			label,
			action,
		}));
	const result: {
		items?: ReturnType<typeof serialize>;
		extraItems?: ReturnType<typeof serialize>;
		align?: string;
	} = {};
	if (menus.items) result.items = serialize(menus.items);
	if (menus.extraItems) result.extraItems = serialize(menus.extraItems);
	if (menus.align) result.align = menus.align;
	return result;
}

// 仅支持 "mdi:名称"；其他集合的图标加进 imports 即可
function inlineIcon(name: string): string | undefined {
	const [prefix, iconName] = name.split(":");
	if (prefix !== "mdi" || !iconName) return undefined;
	const data = getIconData(mdi as never, iconName);
	if (!data) return undefined;
	const { attributes, body } = iconToSVG(data, {});
	const svg = `<svg xmlns="http://www.w3.org/2000/svg" ${Object.entries(
		attributes,
	)
		.map(([k, v]) => `${k}="${String(v)}"`)
		.join(" ")}>${body}</svg>`;
	return `data:image/svg+xml,${encodeURIComponent(svg)}`;
}

const size =
	typeof config.size === "number"
		? { width: config.size, height: config.size }
		: (config.size ?? { width: 300, height: 300 });
---

<!-- 官方 Cubism Core：pixi-live2d-display 只支持 Cubism 3+ 的 moc3，需要
	window.Live2DCubismCore 先就位（模块脚本 defer 执行，时序上必然晚于它）。
	自托管在 pio/models/live2d/ 下，prune-pio-assets 会随 Live2D 开关一起裁剪。 -->
<script is:inline src={url("/pio/models/live2d/live2dcubismcore.min.js")}></script>

<div
	id="l2d-widget-container"
	style={`position: fixed; z-index: 999; width: ${size.width}px; height: ${size.height}px;`}
	data-models={JSON.stringify(modelConfigs)}
	data-position={config.position || "bottom-left"}
	data-primary-color={config.primaryColor || ""}
	data-transition-duration={config.transitionDuration?.toString() || ""}
	data-transition-type={config.transitionType || ""}
	data-menus={JSON.stringify(serializeMenus(config.menus))}
	data-tips={JSON.stringify(config.tips || {})}
	data-responsive={JSON.stringify(config.responsive || {})}
	data-draggable={JSON.stringify(config.draggable || {})}
	data-sleep={JSON.stringify(config.sleep || {})}
	data-sleep-icon={inlineIcon("mdi:sleep") ?? ""}
	data-github-url={profileGithubUrl}
>
</div>

<style is:global>
	#l2d-widget-container {
		/* primaryColor 由脚本注入为 --l2d-primary；无法取值时回退主题默认蓝 */
		--l2d-primary: rgba(96, 165, 250, 0.9);
		user-select: none;
		touch-action: none;
		font-family: inherit;
	}
	#l2d-widget-container .l2d-stage {
		position: relative;
		width: 100%;
		height: 100%;
	}
	#l2d-widget-container canvas.l2d-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	/* 入场/退场动画：slide 用位移、fade 用透明度，时长由脚本按配置写入 */
	#l2d-widget-container.l2d-mode-slide .l2d-stage {
		transition: transform var(--l2d-dur, 1500ms) ease;
	}
	#l2d-widget-container.l2d-mode-slide .l2d-stage.l2d-hidden {
		transform: translateY(130%);
	}
	#l2d-widget-container.l2d-mode-fade .l2d-stage {
		transition: opacity var(--l2d-dur, 1500ms) ease;
	}
	#l2d-widget-container.l2d-mode-fade .l2d-stage.l2d-hidden {
		opacity: 0;
	}
	/* 菜单：悬停看板娘时浮现 */
	#l2d-widget-container .l2d-menus {
		position: absolute;
		top: 10px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	#l2d-widget-container .l2d-menus.l2d-align-left {
		left: 10px;
	}
	#l2d-widget-container .l2d-menus.l2d-align-right {
		right: 10px;
	}
	#l2d-widget-container .l2d-menu-btn {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		border: none;
		padding: 6px;
		background: var(--l2d-primary);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		opacity: 0;
		transition:
			opacity 0.25s ease,
			transform 0.15s ease;
	}
	#l2d-widget-container:hover .l2d-menu-btn,
	#l2d-widget-container.l2d-touch .l2d-menu-btn {
		opacity: 1;
	}
	#l2d-widget-container .l2d-menu-btn:hover {
		transform: scale(1.1);
	}
	#l2d-widget-container .l2d-menu-btn img {
		width: 100%;
		height: 100%;
		/* 内联 SVG 用 currentColor 绘制，反白适配彩色圆底 */
		filter: brightness(0) invert(1);
	}
	#l2d-widget-container .l2d-menu-btn span {
		font-size: 12px;
		line-height: 1;
		color: #fff;
	}
	/* 提示气泡 */
	#l2d-widget-container .l2d-tips {
		position: absolute;
		left: 50%;
		top: -34px;
		transform: translateX(-50%);
		max-width: 220px;
		background: var(--l2d-primary);
		color: #fff;
		font-size: 13px;
		line-height: 1.5;
		padding: 6px 10px;
		border-radius: 8px;
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
		white-space: normal;
		word-break: break-word;
	}
	#l2d-widget-container .l2d-tips.l2d-tips-visible {
		opacity: 1;
	}
	/* 状态条（加载/休息/切换中）：挂在 stage 外，模型退场时仍可见 */
	#l2d-widget-container .l2d-status {
		position: absolute;
		left: -14px;
		top: 50%;
		transform: translateY(-50%);
		background: var(--l2d-primary);
		color: #fff;
		font-size: 12px;
		letter-spacing: 2px;
		padding: 8px 5px;
		border-radius: 8px;
		writing-mode: vertical-lr;
		cursor: pointer;
		display: none;
	}
	#l2d-widget-container .l2d-status.l2d-status-visible {
		display: block;
	}
	#l2d-widget-container .l2d-status.l2d-status-clickable:hover {
		filter: brightness(1.1);
	}
	/* 休眠时容器不再响应交互，只有悬浮球可点 */
	#l2d-widget-container.l2d-sleeping {
		pointer-events: none;
	}
	#l2d-widget-container.l2d-sleeping .l2d-status {
		pointer-events: auto;
	}
	/* 悬浮球：休眠形态。外层只做定位与出入场动画，圆形裁剪在内层 face 上，
		Zzz 气泡字浮在球外不被裁掉。fixed 定位按视口坐标，可拖出容器范围 */
	#l2d-widget-container .l2d-ball {
		position: fixed;
		width: 56px;
		height: 56px;
		cursor: pointer;
		pointer-events: auto;
		touch-action: none;
		filter: drop-shadow(0 3px 8px rgb(0 0 0 / 30%));
		animation: l2d-ball-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
		transition:
			filter 0.25s ease,
			transform 0.25s ease;
	}
	/* 拖动态：抓取光标、球体放大抬起、Zzz 暂停（人在被搬来搬去） */
	#l2d-widget-container .l2d-ball.l2d-ball-dragging {
		cursor: grabbing;
		filter: drop-shadow(0 10px 18px rgb(0 0 0 / 40%));
		transform: scale(1.08);
	}
	#l2d-widget-container .l2d-ball.l2d-ball-dragging .l2d-ball-face,
	#l2d-widget-container .l2d-ball.l2d-ball-dragging .l2d-z {
		animation-play-state: paused;
	}
	/* 点击唤醒的确认波纹：从球心扩散的一圈 */
	#l2d-widget-container .l2d-ball::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 50%;
		box-shadow: 0 0 0 0 var(--l2d-primary);
		opacity: 0;
		pointer-events: none;
	}
	#l2d-widget-container .l2d-ball.l2d-ball-pulse::before {
		animation: l2d-ball-pulse 0.5s ease-out;
	}
	@keyframes l2d-ball-pulse {
		0% {
			opacity: 0.9;
			box-shadow: 0 0 0 0 var(--l2d-primary);
		}
		100% {
			opacity: 0;
			box-shadow: 0 0 0 22px transparent;
		}
	}
	#l2d-widget-container .l2d-ball-face {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		overflow: hidden;
		border: 2px solid var(--l2d-primary);
		animation: l2d-ball-float 3.2s ease-in-out infinite 0.4s;
	}
	#l2d-widget-container .l2d-ball:hover .l2d-ball-face {
		border-color: var(--l2d-primary);
	}
	/* 睡着的样子：轻微降饱和；悬停像搅扰了睡梦，恢复彩色 */
	#l2d-widget-container .l2d-ball-face img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		-webkit-user-drag: none;
		filter: saturate(0.75);
		transition: filter 0.3s ease;
	}
	#l2d-widget-container .l2d-ball:hover .l2d-ball-face img {
		filter: saturate(1);
	}
	/* 飘起的 Zzz：三个错峰的 Z 从球顶升起淡出 */
	#l2d-widget-container .l2d-z {
		position: absolute;
		color: var(--l2d-primary);
		font-weight: 700;
		line-height: 1;
		pointer-events: none;
		text-shadow:
			0 0 4px rgb(255 255 255 / 75%),
			0 1px 2px rgb(0 0 0 / 15%);
		animation: l2d-zzz 2.4s ease-out infinite;
	}
	#l2d-widget-container .l2d-z1 {
		top: -2px;
		right: 8px;
		font-size: 13px;
	}
	#l2d-widget-container .l2d-z2 {
		top: -10px;
		right: -2px;
		font-size: 17px;
		animation-delay: 0.8s;
	}
	#l2d-widget-container .l2d-z3 {
		top: -16px;
		right: -8px;
		font-size: 21px;
		animation-delay: 1.6s;
	}
	@keyframes l2d-ball-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-5px);
		}
	}
	@keyframes l2d-zzz {
		0% {
			opacity: 0;
			transform: translate(2px, 6px) scale(0.5) rotate(-10deg);
		}
		30% {
			opacity: 0.95;
		}
		70% {
			opacity: 0.6;
		}
		100% {
			opacity: 0;
			transform: translate(12px, -16px) scale(1.1) rotate(8deg);
		}
	}
	@keyframes l2d-ball-in {
		from {
			opacity: 0;
			transform: scale(0.3);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
	@keyframes l2d-ball-out {
		to {
			opacity: 0;
			transform: scale(0.3);
		}
	}
	#l2d-widget-container .l2d-ball.l2d-ball-out {
		animation: l2d-ball-out 0.2s ease-in both;
	}
	@media (prefers-reduced-motion: reduce) {
		#l2d-widget-container .l2d-ball,
		#l2d-widget-container .l2d-ball-face,
		#l2d-widget-container .l2d-z {
			animation: none;
		}
		#l2d-widget-container .l2d-z {
			opacity: 0.9;
		}
	}
</style>

<script>
	import * as PIXI from "pixi.js";
	import * as PixiLive2d from "pixi-live2d-display/cubism4";
	import {
		Live2DModel,
		MotionPreloadStrategy,
		MotionPriority,
	} from "pixi-live2d-display/cubism4";

	// CubismFramework 运行时有导出但类型声明缺失；内嵌 Framework 变体实测
	// 没有 getIdManager 静态方法，仅作 lipSyncIds 缺失时的兜底
	const CubismFramework = (PixiLive2d as any).CubismFramework as
		| { getIdManager?: () => { getId: (id: string) => unknown } }
		| undefined;

	// 官方 Core（自托管脚本）挂载的全局
	declare global {
		interface Window {
			Live2DCubismCore?: unknown;
		}
	}

	// Live2DModel 依赖 PIXI.Ticker 驱动逐帧更新（ESM 引入 pixi.js 时不会自动注册）
	Live2DModel.registerTicker(PIXI.Ticker);

	interface ModelConfig {
		path: string;
		volume?: number;
		scale?: number;
		offset?: [number, number];
		/** PSD 画布中人物实体的占比，声明后按人物包围盒适配 */
		charBox?: { x0: number; x1: number; y0: number; y1: number };
	}

	const POSITION_STORAGE_KEY = "live2dPosition";
	const SLEEP_STORAGE_KEY = "live2dSleeping";
	const BALL_POSITION_KEY = "live2dBallPosition";
	const TAP_THROTTLE_MS = 2500;
	const TAP_MAX_DURATION_MS = 400;
	const TAP_MAX_DELTA_PX = 8;

	// 已创建的实例，供重复初始化前销毁（HMR / 组件重建）
	let instance: { destroy: () => void } | null = null;
	let currentModelIndex = 0;

	// 菜单动作映射（action 字符串 → 实际函数）
	const menuActions: Record<string, () => void> = {
		home: () => (window.location.href = "/"),
		scrollToTop: () => window.scrollTo({ top: 0, behavior: "smooth" }),
		sleep: () => controller.sleep(),
		github: () => {
			const el = document.getElementById("l2d-widget-container");
			window.open(el?.dataset.githubUrl || "https://github.com", "_blank");
		},
		switchModel: () =>
			controller.switchModel((currentModelIndex + 1) % modelConfigs.length),
		resetPosition: () => controller.resetPosition(),
	};

	function initWidget() {
		const container = document.getElementById("l2d-widget-container");
		if (!container) return;
		if (!window.Live2DCubismCore) {
			console.error(
				"Live2DWidget: Cubism Core 未加载，看板娘初始化中止。请确认 /pio/models/live2d/live2dcubismcore.min.js 可访问。",
			);
			return;
		}

		// 重复初始化前先释放上一个实例（HMR / 组件重建），否则 WebGL 上下文会
		// 不断新建而不回收，触达浏览器上限（通常 16 个）后最老的上下文被丢弃，
		// 表现为模型突然消失。
		instance?.destroy();
		instance = null;

		try {
			const models: ModelConfig[] = JSON.parse(
				container.dataset.models || "[]",
			);
			if (models.length === 0) {
				console.warn("No Live2D models configured");
				return;
			}
			modelConfigs.splice(0, modelConfigs.length, ...models);

			instance = createWidget(container);
		} catch (e) {
			console.error("Failed to initialize Live2D widget:", e);
		}
	}

	const modelConfigs: ModelConfig[] = [];

	// ---------------- 控制器 ----------------

	const controller = {
		sleep: () => {},
		resetPosition: () => {},
		switchModel: (_index: number) => {},
	};

	function createWidget(container: HTMLElement): { destroy: () => void } {
		const models = modelConfigs;
		const position = container.dataset.position || "bottom-left";
		const primaryColor = container.dataset.primaryColor || "";
		const transitionDuration = container.dataset.transitionDuration
			? Number.parseInt(container.dataset.transitionDuration, 10)
			: 1500;
		const transitionType = container.dataset.transitionType || "slide";
		const menus = JSON.parse(container.dataset.menus || "{}");
		const tips = JSON.parse(container.dataset.tips || "{}");
		const responsive = JSON.parse(container.dataset.responsive || "{}");
		const draggable = JSON.parse(container.dataset.draggable || "{}");
		const sleepConfig = JSON.parse(container.dataset.sleep || "{}");

		if (primaryColor) {
			container.style.setProperty("--l2d-primary", primaryColor);
		}
		container.style.setProperty("--l2d-dur", `${transitionDuration}ms`);
		container.classList.add(`l2d-mode-${transitionType}`);
		if (position === "bottom-right") {
			container.style.right = "0";
			container.style.bottom = "0";
		} else {
			container.style.left = "0";
			container.style.bottom = "0";
		}

		// ---- DOM 骨架 ----
		container.innerHTML = "";
		const stage = document.createElement("div");
		stage.className = "l2d-stage l2d-hidden";
		const canvas = document.createElement("canvas");
		canvas.className = "l2d-canvas";
		stage.appendChild(canvas);
		container.appendChild(stage);

		// 状态条挂在 stage 之外：模型退场（休眠/切换）时仍然可见
		const statusPill = document.createElement("div");
		statusPill.className = "l2d-status";
		container.appendChild(statusPill);

		const showStatus = (text: string, clickable = false) => {
			statusPill.textContent = text;
			statusPill.classList.add("l2d-status-visible");
			statusPill.classList.toggle("l2d-status-clickable", clickable);
		};
		const hideStatus = () => statusPill.classList.remove("l2d-status-visible");

		// ---- PIXI 应用 ----
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const app = new PIXI.Application({
			view: canvas,
			width: container.clientWidth,
			height: container.clientHeight,
			backgroundAlpha: 0,
			antialias: true,
			resolution: dpr,
			autoDensity: true,
		});

		let model: any = null;
		let currentLoadId = 0;
		const timers: number[] = [];
		let tipsTimer = 0;
		const disposers: (() => void)[] = [];

		// 模型更新统一由 app.ticker 驱动（累积 dt，渲染时 _render 消费），
		// 不依赖 Ticker.shared 自启动：后者在部分环境（无 RAF 的自动化页签等）
		// 不会触发，而 app.ticker 由 Application 自己管理渲染循环，路径确定。
		const driveModelUpdate = () => {
			if (model) model.update(app.ticker.deltaMS);
		};
		app.ticker.add(driveModelUpdate);

		// ---- 提示气泡 ----
		const bubble = document.createElement("div");
		bubble.className = "l2d-tips";
		if (tips.offset) {
			bubble.style.marginLeft = `${tips.offset.x ?? 0}px`;
			bubble.style.marginTop = `${tips.offset.y ?? 0}px`;
		}
		stage.appendChild(bubble);

		let bubbleTimer = 0;
		const showBubble = (text: string, duration: number) => {
			bubble.textContent = text;
			bubble.classList.add("l2d-tips-visible");
			window.clearTimeout(bubbleTimer);
			bubbleTimer = window.setTimeout(
				() => bubble.classList.remove("l2d-tips-visible"),
				duration,
			);
		};

		// 打字机 + 口型：type 参数配置后，气泡文字逐字打出并驱动嘴型参数。
		// 帧驱动放在 beforeModelUpdate（晚于动作求值），否则嘴型会被 Idle 覆盖。
		const typing = tips.typing as
			| {
					param?: string;
					speed?: number;
					minValue?: number;
					maxValue?: number;
			  }
			| undefined;
		const typingState: {
			active: boolean;
			text: string;
			shown: number;
			timer: number;
			speed: number;
			min: number;
			max: number;
			paramIndex: number;
		} = {
			active: false,
			text: "",
			shown: 0,
			timer: 0,
			speed: typing?.speed ?? 100,
			min: typing?.minValue ?? 0.5,
			max: typing?.maxValue ?? 1,
			paramIndex: -1,
		};

		const resolveMouthParamIndex = (): number => {
			try {
				if (!model?.internalModel?.coreModel) return -1;
				const im = model.internalModel;
				const core = im.coreModel;
				// Framework 的 CubismModel 查参只认 CubismIdHandle，而内嵌 Framework
				// 变体没有 CubismFramework.getIdManager() 静态方法。model3.json 的
				// LipSync 组已被 motionManager 解析成现成句柄，直接取用；组缺失时
				// 才回退到 typing.param 指定的参数名经 ID 管理器解析。
				const lipHandle = im.motionManager?.lipSyncIds?.[0];
				if (lipHandle) return core.getParameterIndex(lipHandle);
				const idManager = CubismFramework?.getIdManager?.();
				if (!idManager) return -1;
				return core.getParameterIndex(
					idManager.getId(typing?.param || "ParamMouthOpenY"),
				);
			} catch {
				// 口型解析失败只应降级成「无口型」，绝不能炸掉整个加载流程
				return -1;
			}
		};

		const onBeforeModelUpdate = () => {
			if (!typingState.active || typingState.paramIndex < 0) return;
			const core = model?.internalModel?.coreModel;
			if (!core) return;
			// 逐字符随机开合会抖成筛子；用两个错相正弦叠出连续波形，
			// 在 min~max 之间起伏，接近说话的节律
			const t = performance.now() / 1000;
			const wave =
				(Math.sin(t * 9.3) + Math.sin(t * 4.7 + 1.3)) / 4 + 0.5; // 0~1
			core.setParameterValueByIndex(
				typingState.paramIndex,
				typingState.min + wave * (typingState.max - typingState.min),
			);
		};

		const showTypingBubble = (text: string, duration: number) => {
			if (!typing) {
				showBubble(text, duration);
				return;
			}
			window.clearInterval(typingState.timer);
			bubble.textContent = "";
			bubble.classList.add("l2d-tips-visible");
			typingState.active = true;
			typingState.text = text;
			typingState.shown = 0;
			typingState.paramIndex = resolveMouthParamIndex();
			typingState.timer = window.setInterval(() => {
				typingState.shown += 1;
				bubble.textContent = text.slice(0, typingState.shown);
				if (typingState.shown >= text.length) {
					window.clearInterval(typingState.timer);
					typingState.active = false;
					// 口型归零，别让嘴停在半开（Idle 会接管，这里兜底）
					if (typingState.paramIndex >= 0) {
						model?.internalModel?.coreModel?.setParameterValueByIndex(
							typingState.paramIndex,
							0,
						);
					}
					window.setTimeout(
						() => bubble.classList.remove("l2d-tips-visible"),
						duration,
					);
				}
			}, typingState.speed);
		};

		const startTipsRotation = () => {
			if (tips.enable === false) return;
			const messages: string[] = tips.messages ?? [];
			const duration: number = tips.duration ?? 3000;
			const interval: number = tips.interval ?? 5000;
			if (!messages.length) return;
			let idx = Math.floor(Math.random() * messages.length);
			showTypingBubble(messages[idx], duration);
			// 切换模型会重新进入这里，先清掉上一轮的循环再注册，避免多份轮换叠加
			window.clearInterval(tipsTimer);
			tipsTimer = window.setInterval(() => {
				idx = (idx + 1) % messages.length;
				showTypingBubble(messages[idx], duration);
			}, Math.max(interval, duration));
		};

		// ---- 模型加载与适配 ----

		// PSD2Live 1.3.0 导出的 moc 把发珠（ArtMeshHeadwear）压在刘海之下，
		// 与 PSD 层序不符；工程侧的 draw_order 编辑对无参数轴的静态网格是空操作。
		// 这里在运行时提升发珠渲染序（移植自模型工程的演示页）。导出顺序修正后
		// 该补丁自动退化为空操作。
		function applyHeadwearPatch(m: any) {
			const core = m.internalModel?.coreModel;
			if (!core?.getDrawableCount) return;
			const ids: string[] = [];
			for (let i = 0; i < core.getDrawableCount(); i++) {
				ids.push(core.getDrawableId(i));
			}
			const hw = ids.indexOf("ArtMeshHeadwear");
			const fh = ids.indexOf("ArtMeshFrontHair");
			if (hw < 0 || fh < 0) return;
			const rawOrders = core.getDrawableRenderOrders.bind(core);
			core.getDrawableRenderOrders = function () {
				const arr: Int32Array = rawOrders();
				if (arr[hw] >= arr[fh]) return arr;
				const fixed = Int32Array.from(arr);
				const from = arr[hw];
				for (let i = 0; i < fixed.length; i++) {
					if (fixed[i] > from) fixed[i] -= 1;
				}
				fixed[hw] = Math.max(...Array.from(arr));
				return fixed;
			};
		}

		function fitModel() {
			if (!model) return;
			const w = container.clientWidth;
			const h = container.clientHeight;
			const cfg = models[currentModelIndex] ?? {};
			const iw = model.internalModel.width;
			const ih = model.internalModel.height;
			// PSD 画布含大片透明边距（人物只占约六成宽、九成高），按整画布 contain
			// 适配会让底部锚定的人物头顶留出一大块空区、与菜单列错位。声明了
			// charBox 时按人物包围盒适配：底边贴画布底、高度撑满，水平居中；
			// 未声明则退回整画布 contain。
			const box = cfg.charBox;
			const base = box
				? Math.min(
						w / ((box.x1 - box.x0) * iw),
						h / ((box.y1 - box.y0) * ih),
					)
				: Math.min(w / iw, h / ih);
			const scale = base * (cfg.scale ?? 1);
			model.scale.set(scale);
			model.anchor.set(0.5, 1);
			// anchor(0.5,1) 的枢轴在整画布底部中心；把人物底缘对到画布底、
			// 人物中心对到画布水平中点
			const charCx = box ? ((box.x0 + box.x1) / 2) * iw : iw / 2;
			const charBottom = box ? box.y1 * ih : ih;
			model.position.set(
				w / 2 - (charCx - iw / 2) * scale + (cfg.offset?.[0] ?? 0) * w,
				h + (ih - charBottom) * scale - (cfg.offset?.[1] ?? 0) * h,
			);
		}

		async function loadModel(index: number): Promise<void> {
			const loadId = ++currentLoadId;
			const path = models[index]?.path;
			if (!path) return;
			showStatus("正在加载");
			const m = await Live2DModel.from(path, {
				autoInteract: false,
				motionPreload: MotionPreloadStrategy.IDLE,
				autoUpdate: false,
			});
			// 加载期间可能已切换/销毁，丢弃过期结果
			if (loadId !== currentLoadId) {
				m.destroy();
				return;
			}
			if (model) {
				if (typing) {
					model.internalModel?.off?.(
						"beforeModelUpdate",
						onBeforeModelUpdate,
					);
				}
				app.stage.removeChild(model);
				model.destroy();
			}
			model = m;
			currentModelIndex = index;
			applyHeadwearPatch(m);
			app.stage.addChild(m);
			if (typing) {
				// 帧驱动挂在当前模型上；换模型后要重新挂
				m.internalModel?.on?.("beforeModelUpdate", onBeforeModelUpdate);
			}
			fitModel();
			hideStatus();
			stage.classList.remove("l2d-hidden");
			if (tips.enable !== false && tips.welcomeMessage?.length) {
				showTypingBubble(
					tips.welcomeMessage[
						Math.floor(Math.random() * tips.welcomeMessage.length)
					],
					tips.duration ?? 3000,
				);
			}
			startTipsRotation();
		}

		// ---- 交互：鼠标跟随 + 点击反应 ----
		// autoInteract 关闭后自己接线：跟随挂 document 级 pointermove（视线跟随
		// 页面任意位置的光标，l2d-widget 时代即如此），focus 只取相对模型中心的
		// 方向，画布外坐标（负值/超界）天然成立；光标离开浏览器窗口时回正。
		// 点击播 TapBody 动作，节流防连点打断。
		// 画布矩形缓存：fixed 元素不因滚动失效，拖动/resize 时由各自路径刷新；
		// 鼠标跟随每帧读 rect 是纯浪费
		let canvasRect: { left: number; top: number } | null = null;
		const refreshCanvasRect = () => {
			canvasRect = null;
		};
		const toCanvasPoint = (e: PointerEvent) => {
			if (!canvasRect) {
				const rect = canvas.getBoundingClientRect();
				canvasRect = { left: rect.left, top: rect.top };
			}
			return { x: e.clientX - canvasRect.left, y: e.clientY - canvasRect.top };
		};
		const onDocumentMove = (e: PointerEvent) => {
			// 睡眠中 ticker 已停，写参数只会让唤醒第一帧闪一个怪表情
			if (!model || sleeping) return;
			const p = toCanvasPoint(e);
			model.focus(p.x, p.y);
		};
		const onDocumentOut = (e: MouseEvent) => {
			// relatedTarget 为空才是真正离开窗口，切标签页/悬停浏览器 UI 时触发
			if (e.relatedTarget || !model || sleeping) return;
			model.focus(container.clientWidth / 2, container.clientHeight / 2);
		};
		document.addEventListener("pointermove", onDocumentMove, {
			passive: true,
		});
		document.addEventListener("mouseout", onDocumentOut);
		let downAt = 0;
		let downX = 0;
		let downY = 0;
		let lastTapAt = 0;
		const onPointerDown = (e: PointerEvent) => {
			downAt = performance.now();
			downX = e.clientX;
			downY = e.clientY;
		};
		const onPointerUp = (e: PointerEvent) => {
			if (!model) return;
			// 长按或位移过大的都属于拖动，不触发点击动作
			if (performance.now() - downAt > TAP_MAX_DURATION_MS) return;
			if (Math.hypot(e.clientX - downX, e.clientY - downY) > TAP_MAX_DELTA_PX)
				return;
			if (performance.now() - lastTapAt < TAP_THROTTLE_MS) return;
			lastTapAt = performance.now();
			model.motion("TapBody", undefined, MotionPriority.NORMAL);
		};
		canvas.addEventListener("pointerdown", onPointerDown);
		canvas.addEventListener("pointerup", onPointerUp);
		disposers.push(() => {
			document.removeEventListener("pointermove", onDocumentMove);
			document.removeEventListener("mouseout", onDocumentOut);
			canvas.removeEventListener("pointerdown", onPointerDown);
			canvas.removeEventListener("pointerup", onPointerUp);
		});

		// 打字口型的帧驱动钩子已在 loadModel 里挂到当前模型上（此处尚无模型）

		// ---- 菜单 ----
		const menuItems = [
			...(menus.items ?? []),
			...(menus.extraItems ?? []),
		] as { icon?: string; label: string; action: string }[];
		if (menuItems.length) {
			const box = document.createElement("div");
			box.className = `l2d-menus l2d-align-${menus.align ?? "right"}`;
			for (const item of menuItems) {
				const btn = document.createElement("button");
				btn.type = "button";
				btn.className = "l2d-menu-btn";
				btn.title = item.label;
				btn.setAttribute("aria-label", item.label);
				if (item.icon) {
					const img = document.createElement("img");
					img.src = item.icon; // 构建期内联的 SVG data URI
					img.alt = "";
					btn.appendChild(img);
				} else {
					btn.textContent = item.label.slice(0, 1);
				}
				btn.addEventListener("click", () => menuActions[item.action]?.());
				box.appendChild(btn);
			}
			stage.appendChild(box);
		}

		// ---- 休眠（悬浮球）/ 唤醒 / 失败重试 ----
		// 休眠时模型滑出、缩成一颗 56px 悬浮球（球面 = 头部快照，模型未加载时
		// 用内置图标兜底），可拖动、点球唤醒；渲染循环随之暂停省 GPU。
		// 触发：菜单休眠（手动，持久化）/ 无操作超时（自动）/ 切走标签页（自动）。
		// 手动休眠跨刷新保持；自动休眠（含标签页触发）不持久化，任何活动即醒。
		// failedAt 记录加载失败的是哪个模型，点状态条重试同一个而不是从头来。
		let failedAt: number | null = null;
		const describeError = (e: unknown): string => {
			const msg = e instanceof Error ? e.message : String(e);
			if (/404|Failed to fetch|NetworkError|fetch/i.test(msg)) {
				return "模型加载失败：找不到文件或网络错误（点击重试）";
			}
			if (/cors|cross-origin|blocked/i.test(msg)) {
				return "模型加载失败：跨域被拦（点击重试）";
			}
			if (/settings|json|parse|moc3|Unexpected/i.test(msg)) {
				return "模型加载失败：模型文件损坏（点击重试）";
			}
			return "模型加载失败（点击重试）";
		};
		const onLoadFail = (index: number, e: unknown) => {
			console.error("Failed to load Live2D model:", e);
			failedAt = index;
			showStatus(describeError(e), true);
		};

		// 头部快照：把当前舞台渲染结果裁成方图。裁剪区域按头部相关网格的实际
		// 包围盒计算（待机动作/物理会把头挤离固定位置，按比例硬猜会裁偏）。
		// 注意用 InternalModel.getDrawableBounds（逻辑坐标，与 toModelPosition
		// 同空间）；核心层 getDrawableVertices 是另一套归一空间，别混用。
		// extract 插件自己走一遍渲染管线，不依赖 preserveDrawingBuffer。
		const takeSnapshot = (): string | null => {
			try {
				const extract = (app.renderer as any).plugins?.extract;
				if (!extract || !model) return null;
				const im = model.internalModel;
				const core = im.coreModel;
				const iw = im.width;
				const ih = im.height;
				// 睡颜帧：借 beforeModelUpdate 钩子（动作求值后、绘制前）阖眼并
				// 让头微微一歪，快照里就是真的睡着的样子；泵 1ms 触发一次重绘，
				// 帧末 loadParameters 会把参数复原，不影响之后的动画。
				const eyeHandles = im.motionManager?.eyeBlinkIds ?? [];
				const angleZHandle = im.idParamAngleZ;
				const onSleepPose = () => {
					for (const h of eyeHandles) {
						core.setParameterValueByIndex(core.getParameterIndex(h), 0.02);
					}
					if (angleZHandle) {
						core.setParameterValueById(angleZHandle, -6);
					}
				};
				im.on?.("beforeModelUpdate", onSleepPose);
				let full: HTMLCanvasElement;
				try {
					model.update(1); // 累积 dt，让接下来的 extract 消费并重绘一帧
					full = extract.canvas(app.stage);
				} finally {
					// 摘钩子必须放 finally：extract 中途抛异常时钩子若残留，
					// 模型从此每帧闭眼歪头
					im.off?.("beforeModelUpdate", onSleepPose);
				}
				const n = core.getDrawableCount();
				let minX = Infinity;
				let maxX = -Infinity;
				let minY = Infinity;
				let maxY = -Infinity;
				let face: { x: number; y: number; w: number; h: number } | null = null;
				for (let i = 0; i < n; i++) {
					// 只取头部部件。锚定 ArtMesh 前缀做整词匹配：裸的 /Ear/ 会作为
					// 子串命中 Footwear/Legwear/Topwear/Handwear（含 wear→ear），
					// 把包围盒一路拽到脚部，快照就裁成衣服了
					const id = core.getDrawableId(i);
					if (
						!/^ArtMesh(Face|FrontHair|Headwear|Eyelash|Eyewhite|Irides|Eyebrow|Nose|Mouth|Ears)/i.test(
							id,
						)
					) {
						continue;
					}
					const b = im.getDrawableBounds(i, {
						x: 0,
						y: 0,
						width: 0,
						height: 0,
					});
					if (!b || !Number.isFinite(b.x)) continue;
					minX = Math.min(minX, b.x);
					maxX = Math.max(maxX, b.x + b.width);
					minY = Math.min(minY, b.y);
					maxY = Math.max(maxY, b.y + b.height);
					// Face 网格单独记下：它是头像裁剪的锚点
					if (/^ArtMeshFace$/i.test(id)) {
						face = { x: b.x, y: b.y, w: b.width, h: b.height };
					}
				}
				if (!Number.isFinite(minX)) return null;
			// extract.canvas 输出的像素网格 = stage 本地包围盒（模型逻辑画布 ×
			// 模型缩放），原点在包围盒左上角——不是屏幕画布，与 dpr 无关。
			// 逻辑坐标 → extract 坐标：先按 anchor 换到 stage 坐标，再减包围盒原点。
			const stageBounds = app.stage.getLocalBounds();
			const toExtractX = (lx: number) =>
				model.position.x + (lx - 0.5 * iw) * model.scale.x - stageBounds.x;
			const toExtractY = (ly: number) =>
				model.position.y + (ly - ih) * model.scale.y - stageBounds.y;
			// 头像式裁剪：有 Face 网格就以脸中心为锚、边长按脸高放大约 1.7 倍
			//（盖住头发）；没有 Face 的模型退回头部部件并集
			let cx: number;
			let cy: number;
			let sideLogical: number;
			if (face) {
				cx = toExtractX(face.x + face.w / 2);
				cy = toExtractY(face.y + face.h / 2);
				sideLogical = Math.max(face.w, face.h) * 1.7;
			} else {
				cx = toExtractX((minX + maxX) / 2);
				cy = toExtractY((minY + maxY) / 2);
				sideLogical = Math.max(maxX - minX, maxY - minY) * 1.15;
			}
			const side = Math.min(
				sideLogical * model.scale.x,
				full.width,
				full.height,
			);
			const sx = Math.min(Math.max(0, cx - side / 2), full.width - side);
			const sy = Math.min(Math.max(0, cy - side / 2), full.height - side);
			const out = document.createElement("canvas");
			out.width = out.height = 112;
			out.getContext("2d")?.drawImage(
				full,
				sx,
				sy,
				side,
				side,
				0,
				0,
				112,
				112,
			);
			return out.toDataURL("image/png");
			} catch {
				return null;
			}
		};

		let sleeping = false;
		let autoAsleep = false;
		let ball: HTMLDivElement | null = null;
		let pauseTimer = 0;
		let idleTimer = 0;

		const readBallPosition = (): { left: number; top: number } | null => {
			try {
				const raw = localStorage.getItem(BALL_POSITION_KEY);
				if (!raw) return null;
				const parsed = JSON.parse(raw);
				if (typeof parsed?.left !== "number" || typeof parsed?.top !== "number") {
					return null;
				}
				return parsed;
			} catch {
				return null;
			}
		};

		const buildBall = (): HTMLDivElement => {
			const el = document.createElement("div");
			el.className = "l2d-ball";
			el.setAttribute("aria-label", "看板娘休眠中，点击唤醒");
			el.title = "看板娘休眠中，点击唤醒";
			// 球面单独一层：圆形裁剪只作用于头像，Zzz 气泡字浮在球外不被裁
			const face = document.createElement("div");
			face.className = "l2d-ball-face";
			const img = document.createElement("img");
			img.src = takeSnapshot() ?? container.dataset.sleepIcon ?? "";
			img.alt = "";
			img.draggable = false; // 禁掉原生图片拖拽，别跟球的拖动抢事件
			face.appendChild(img);
			el.appendChild(face);
			for (let i = 1; i <= 3; i++) {
				const z = document.createElement("span");
				z.className = `l2d-z l2d-z${i}`;
				z.textContent = "Z";
				z.setAttribute("aria-hidden", "true");
				el.appendChild(z);
			}
			// 默认落在容器右上角附近；拖过的位置有记忆
			const rect = container.getBoundingClientRect();
			const saved = readBallPosition();
			el.style.left = `${Math.max(0, saved?.left ?? rect.right - 72)}px`;
			el.style.top = `${Math.max(0, saved?.top ?? rect.top + 8)}px`;

			// 拖动与点击的区分：按住后位移超过 6px 算拖动（松手记忆位置），
			// 否则算点击唤醒。所有事件 stopPropagation：球在容器内部，冒泡到
			// 容器会触发模型拖动的长按计时器，150ms 后容器 setPointerCapture
			// 抢走指针，球的 pointerup 从此收不到——球就"黏"在光标上，
			// 直到再点一下（而那一下 moved=false，又变成唤醒）。
			// pointerdown 必须 preventDefault：球面是 <img>，不拦住的话按下后
			// 浏览器会启动原生图片拖拽，pointer 事件序列被 pointercancel 掐断。
			let pressing = false;
			let downX = 0;
			let downY = 0;
			let startLeft = 0;
			let startTop = 0;
			let moved = false;
			let capturedPointer = 0;
			const releaseCapture = () => {
				if (!capturedPointer) return;
				try {
					el.releasePointerCapture?.(capturedPointer);
				} catch {
					/* 指针可能已释放 */
				}
				capturedPointer = 0;
			};
			el.addEventListener("pointerdown", (e) => {
				if (e.button !== 0) return;
				e.preventDefault();
				e.stopPropagation();
				pressing = true;
				downX = e.clientX;
				downY = e.clientY;
				startLeft = Number.parseFloat(el.style.left) || 0;
				startTop = Number.parseFloat(el.style.top) || 0;
				moved = false;
				try {
					el.setPointerCapture?.(e.pointerId);
					capturedPointer = e.pointerId;
				} catch {
					/* 指针可能已释放 */
				}
			});
			el.addEventListener("pointermove", (e) => {
				e.stopPropagation();
				// 无按键的移动一律忽略（pointermove 不带按键信息，用
				// buttons 位掩码判），防御历史残留的 pressing 状态
				if (!pressing || e.buttons === 0) {
					if (!pressing) return;
					// 按住标记还在但按键已不在：自愈，别再黏着光标
					pressing = false;
					moved = false;
					releaseCapture();
					return;
				}
				const dx = e.clientX - downX;
				const dy = e.clientY - downY;
				if (!moved && Math.hypot(dx, dy) <= 6) return;
				if (!moved) {
					moved = true;
					el.classList.add("l2d-ball-dragging");
				}
				const next = clampPosition(el, startLeft + dx, startTop + dy);
				el.style.left = `${next.left}px`;
				el.style.top = `${next.top}px`;
			});
			el.addEventListener("pointerup", (e) => {
				e.stopPropagation();
				const wasPressing = pressing;
				pressing = false;
				releaseCapture();
				el.classList.remove("l2d-ball-dragging");
				if (!wasPressing) return;
				if (!moved) {
					// 唤醒前先播一圈确认波纹，收缩退场与它重叠播放
					el.classList.add("l2d-ball-pulse");
					wake();
					return;
				}
				const r = el.getBoundingClientRect();
				try {
					localStorage.setItem(
						BALL_POSITION_KEY,
						JSON.stringify({ left: r.left, top: r.top }),
					);
				} catch {
					/* 位置记忆是增强功能 */
				}
			});
			el.addEventListener("pointercancel", () => {
				pressing = false;
				moved = false;
				releaseCapture();
				el.classList.remove("l2d-ball-dragging");
			});
			container.appendChild(el);
			return el;
		};

		const sleep = (reason: "manual" | "auto" | "hidden") => {
			if (sleeping) return;
			sleeping = true;
			autoAsleep = reason !== "manual";
			container.classList.add("l2d-sleeping");
			stage.classList.add("l2d-hidden");
			if (reason === "manual") {
				try {
					localStorage.setItem(SLEEP_STORAGE_KEY, "1");
				} catch {
					/* 状态持久化是增强功能 */
				}
			}
			ball = buildBall();
			// 出场动画播完再暂停渲染循环：休眠期间不烧 GPU
			pauseTimer = window.setTimeout(() => {
				if (sleeping) app.ticker.stop();
			}, transitionDuration + 100);
			window.clearInterval(tipsTimer);
			typingState.active = false;
			window.clearInterval(typingState.timer);
		};

		const wake = () => {
			if (!sleeping) return;
			sleeping = false;
			autoAsleep = false;
			if (ball) {
				// 收缩退场后再移除，跟模型的滑入衔接；container 清空时节点
				// 会随之消失，这里只需摘掉引用
				const b = ball;
				b.classList.add("l2d-ball-out");
				window.setTimeout(() => b.remove(), 220);
				ball = null;
			}
			window.clearTimeout(pauseTimer);
			app.ticker.start();
			container.classList.remove("l2d-sleeping");
			stage.classList.remove("l2d-hidden");
			try {
				localStorage.setItem(SLEEP_STORAGE_KEY, "0");
			} catch {
				/* 同上 */
			}
			if (!model) {
				// 入睡态启动（刷新前是休眠状态）时模型未加载，唤醒时补加载
				loadModel(0).catch((e) => onLoadFail(0, e));
			} else {
				startTipsRotation();
			}
		};

		statusPill.addEventListener("click", () => {
			if (failedAt !== null) {
				const index = failedAt;
				failedAt = null;
				showStatus("正在加载");
				loadModel(index).catch((e) => onLoadFail(index, e));
			}
		});
		controller.sleep = () => sleep("manual");
		controller.switchModel = (index: number) => {
			if (models.length < 2 || index === currentModelIndex) return;
			showStatus("切换中");
			loadModel(index).catch((e) => {
				console.error("Failed to switch Live2D model:", e);
				hideStatus();
			});
		};

		// ---- 自动休眠触发 ----
		// 切走标签页自动睡、回来唤醒；无操作超过阈值自动睡、任何输入立即醒
		//（仅自动休眠态；手动休眠只认点球唤醒）。
		const autoSleepMinutes = Math.max(
			0,
			sleepConfig?.autoSleepMinutes ?? 5,
		);
		const onVisibilityChange = () => {
			if (document.hidden) {
				if (!sleeping && model) sleep("hidden");
			} else if (autoAsleep) {
				wake();
			}
		};
		const resetIdleTimer = () => {
			window.clearTimeout(idleTimer);
			if (!autoSleepMinutes) return;
			idleTimer = window.setTimeout(
				() => {
					if (!sleeping && model) sleep("auto");
				},
				autoSleepMinutes * 60_000,
			);
		};
		const onUserActivity = () => {
			resetIdleTimer();
			if (sleeping && autoAsleep) wake();
		};
		document.addEventListener("visibilitychange", onVisibilityChange);
		for (const evt of [
			"pointermove",
			"pointerdown",
			"keydown",
			"wheel",
			"scroll",
		] as const) {
			document.addEventListener(evt, onUserActivity, { passive: true });
		}
		// ---- 拖动（长按启动，位置记忆）----
		// 动画只作用于内层 stage（transform/opacity），拖动只改容器 left/top，
		// 两者互不干扰。
		const dragDetach = setupDrag(
			container,
			stage,
			draggable,
			() => sleeping,
			refreshCanvasRect,
		);
		controller.resetPosition = () => {
			container.style.left = "";
			container.style.top = "";
			container.style.right = "";
			container.style.bottom = "";
			try {
				localStorage.removeItem(POSITION_STORAGE_KEY);
			} catch {
				/* 位置记忆是增强功能，失败不影响看板娘 */
			}
		};

		// ---- 移动端隐藏 ----
		const breakpoint = responsive.mobileBreakpoint || 768;
		const applyResponsive = () => {
			if (!responsive.hideOnMobile) return true;
			const hidden = window.innerWidth <= breakpoint;
			container.style.display = hidden ? "none" : "";
			return !hidden;
		};

		// ---- 首次加载 ----
		// 上次手动休眠过则直接以悬浮球入睡态启动：不加载模型不跑渲染，
		// 点球唤醒时再补加载
		const savedSleeping = (() => {
			try {
				return localStorage.getItem(SLEEP_STORAGE_KEY) === "1";
			} catch {
				return false;
			}
		})();
		if (savedSleeping) {
			sleeping = true;
			container.classList.add("l2d-sleeping");
			ball = buildBall();
		} else if (applyResponsive()) {
			loadModel(0).catch((e) => onLoadFail(0, e));
		}

		// 开发期调试句柄：浏览器控制台可直接查看模型状态、验证绑定与渲染顺序
		if (import.meta.env.DEV) {
			(window as any).__l2dDebug = {
				get model() {
					return model;
				},
				get sleeping() {
					return sleeping;
				},
				app,
				sleep: () => controller.sleep(),
				wake,
				switchModel: controller.switchModel,
			};
		}

		const onResize = () => {
			refreshCanvasRect(); // 画布位置变了，跟随用的矩形缓存作废
			const visible = applyResponsive();
			// 隐藏期间跳过加载，重新可见时再懒加载（此前失败过就重试同一个）；
			// 休眠态不加载，唤醒时才补
			if (visible && !model && !sleeping) {
				const index = failedAt ?? 0;
				failedAt = null;
				loadModel(index).catch((e) => onLoadFail(index, e));
			}
		};
		window.addEventListener("resize", onResize);

		// 切页后重置模型索引：挂件在 swup 管理范围之外，切页不会重建它，
		// 不重置的话「切换模型」会从切页前的位置继续自增，与显示对不上。
		const onSwupPageView = () => {
			currentModelIndex = 0;
		};
		document.addEventListener("swup:page:view", onSwupPageView);

		return {
			destroy: () => {
				currentLoadId += 1; // 让在途的 loadModel 丢弃结果
				app.ticker.remove(driveModelUpdate);
				dragDetach();
				window.removeEventListener("resize", onResize);
				document.removeEventListener("swup:page:view", onSwupPageView);
				document.removeEventListener(
					"visibilitychange",
					onVisibilityChange,
				);
				for (const evt of [
					"pointermove",
					"pointerdown",
					"keydown",
					"wheel",
					"scroll",
				] as const) {
					document.removeEventListener(evt, onUserActivity);
				}
				window.clearTimeout(idleTimer);
				window.clearTimeout(pauseTimer);
				for (const t of timers) window.clearInterval(t);
				window.clearInterval(tipsTimer);
				window.clearTimeout(bubbleTimer);
				window.clearInterval(typingState.timer);
				typingState.active = false;
				for (const d of disposers) d();
				try {
					model?.destroy();
				} catch {
					/* 模型可能尚未加载完成 */
				}
				// removeView 连同 canvas 一起移除，WebGL 上下文随之释放
				app.destroy(true, { children: true, texture: true, baseTexture: true });
				container.innerHTML = "";
				container.className = "";
				// 只清掉运行期写入的动态定位，保留模板里的尺寸/层级基础样式
				container.style.left = "";
				container.style.top = "";
				container.style.right = "";
				container.style.bottom = "";
			},
		};
	}

	// ---------------- 拖动 ----------------

	function readSavedPosition(): { left: number; top: number } | null {
		try {
			const raw = localStorage.getItem(POSITION_STORAGE_KEY);
			if (!raw) return null;
			const parsed = JSON.parse(raw);
			if (typeof parsed?.left !== "number" || typeof parsed?.top !== "number") {
				return null;
			}
			return { left: parsed.left, top: parsed.top };
		} catch {
			// localStorage 不可用或内容损坏时静默回退到默认位置
			return null;
		}
	}

	function savePosition(left: number, top: number): void {
		try {
			localStorage.setItem(
				POSITION_STORAGE_KEY,
				JSON.stringify({ left, top }),
			);
		} catch {
			// 静默忽略：位置记忆是增强功能，失败不应影响看板娘
		}
	}

	/** 把 left/top 钳制在视口内，避免窗口缩小后模型跑到屏幕外找不回来。 */
	function clampPosition(
		el: HTMLElement,
		left: number,
		top: number,
	): { left: number; top: number } {
		const rect = el.getBoundingClientRect();
		const maxLeft = Math.max(0, window.innerWidth - rect.width);
		const maxTop = Math.max(0, window.innerHeight - rect.height);
		return {
			left: Math.min(Math.max(0, left), maxLeft),
			top: Math.min(Math.max(0, top), maxTop),
		};
	}

	function setupDrag(
		container: HTMLElement,
		_stage: HTMLElement,
		draggable: {
			enable?: boolean;
			longPressMs?: number;
			savePosition?: boolean;
		},
		isSleeping: () => boolean,
		onContainerMoved?: () => void,
	): () => void {
		if (draggable.enable === false) return () => {};

		const longPressMs =
			typeof draggable.longPressMs === "number" ? draggable.longPressMs : 150;

		// 恢复上次位置；没有记录就沿用配置的角落定位
		const saved = draggable.savePosition !== false ? readSavedPosition() : null;
		if (saved) {
			container.style.bottom = "auto";
			container.style.right = "auto";
			const clamped = clampPosition(container, saved.left, saved.top);
			container.style.left = `${clamped.left}px`;
			container.style.top = `${clamped.top}px`;
		}

		let pressTimer: number | null = null;
		let dragging = false;
		let startX = 0;
		let startY = 0;
		let originLeft = 0;
		let originTop = 0;
		let pointerId: number | null = null;
		let hasCapture = false;

		const clearPressTimer = () => {
			if (pressTimer !== null) {
				window.clearTimeout(pressTimer);
				pressTimer = null;
			}
		};

		const onPointerDown = (event: PointerEvent) => {
			if (event.button !== 0) return;
			// 睡眠时容器的拖动旁路：此时模型已滑出，容器只剩隐形区域，
			// 长按会启动幽灵拖动、还会抢走悬浮球的指针捕获（pointerup 被
			// 钳断，球就"黏"在光标上）
			if (isSleeping()) return;
			clearPressTimer();
			pressTimer = window.setTimeout(() => {
				pressTimer = null;
				dragging = true;
				pointerId = event.pointerId;
				const rect = container.getBoundingClientRect();
				startX = event.clientX;
				startY = event.clientY;
				originLeft = rect.left;
				originTop = rect.top;
				container.style.cursor = "grabbing";
				// 捕获指针，让拖动期间的事件即使在模型外也继续送达。
				// 必须 try/catch：指针可能已经释放（快速点击、触屏取消），
				// 此时会抛 NotFoundError，未捕获会中断整个拖动初始化。
				try {
					container.setPointerCapture?.(event.pointerId);
					hasCapture = true;
				} catch {
					hasCapture = false;
				}
			}, longPressMs);
		};

		const onPointerMove = (event: PointerEvent) => {
			if (!dragging) return;
			// 只认触发拖动的那个指针，避免多指/多设备事件串扰
			if (pointerId !== null && event.pointerId !== pointerId) return;
			const next = clampPosition(
				container,
				originLeft + (event.clientX - startX),
				originTop + (event.clientY - startY),
			);
			container.style.left = `${next.left}px`;
			container.style.top = `${next.top}px`;
		};

		const endDrag = () => {
			clearPressTimer();
			if (!dragging) return;
			dragging = false;
			container.style.cursor = "";
			if (pointerId !== null) {
				// 只在确实捕获成功时释放；否则同样会抛 NotFoundError
				if (hasCapture) {
					try {
						container.releasePointerCapture?.(pointerId);
					} catch {
						/* 指针已释放，忽略 */
					}
				}
				hasCapture = false;
				pointerId = null;
			}
			// 松手时按钳制后的最终值落位，保证「屏幕上的位置」与「存下来的位置」一致
			const rect = container.getBoundingClientRect();
			const final = clampPosition(container, rect.left, rect.top);
			container.style.left = `${final.left}px`;
			container.style.top = `${final.top}px`;
			// 容器动了，画布也跟着动；作废跟随用的矩形缓存
			onContainerMoved?.();
			if (draggable.savePosition !== false) {
				savePosition(final.left, final.top);
			}
		};

		container.addEventListener("pointerdown", onPointerDown);
		container.addEventListener("pointermove", onPointerMove);
		container.addEventListener("pointerup", endDrag);
		container.addEventListener("pointercancel", endDrag);

		return () => {
			clearPressTimer();
			container.removeEventListener("pointerdown", onPointerDown);
			container.removeEventListener("pointermove", onPointerMove);
			container.removeEventListener("pointerup", endDrag);
			container.removeEventListener("pointercancel", endDrag);
			container.style.cursor = "";
		};
	}

	// 确保只初始化一次
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initWidget);
	} else {
		initWidget();
	}
</script>
